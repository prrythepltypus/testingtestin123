# Groq API key used server-side only for Llama 3 tag extraction, PII scrubbing, crisis triage, and chat moderation
GROQ_API_KEY=your_groq_api_key_here

# Public Supabase URL for connecting to the project database and realtime engine (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anonymous Key for client-side anonymous session authentication (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Secret Supabase Service Role Key used server-side only for secure administrative queries and vector operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
